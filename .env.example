# ---- Frontend (exposed to the browser — never put secrets here) ----
# Optional: your UPI ID, enables the "Pay by UPI" option at checkout
VITE_UPI_ID=
# Optional: base URL of the order API if hosted elsewhere (leave empty to use /api via the dev proxy)
VITE_API_BASE=

# ---- Server only (server/index.js) ----
# Google Apps Script web-app URL (see apps-script/Code.gs)
APPS_SCRIPT_URL=
# Shared secret, must match SECRET in Code.gs
APPS_SCRIPT_SECRET=
# Allowed browser origin(s), comma separated
ALLOWED_ORIGIN=http://localhost:5173
PORT=8787
